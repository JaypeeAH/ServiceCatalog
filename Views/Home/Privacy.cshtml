@{
    ViewData["Title"] = "About GBFS";
}

<section class="hero-section">
    <div class="container">
        <h1 class="hero-title">About Global Business & Finance Services</h1>
        <p class="hero-subtitle">Supporting Cardinal Health's mission worldwide</p>
    </div>
</section>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-5">
                    <h3 style="color: var(--cardinal-red);" class="mb-4">Our Mission</h3>
                    <p class="lead">
                        Global Business & Finance Services (GBFS) is the backbone of Cardinal Health's operational
                        excellence,
                        providing critical support services across multiple functions and geographic locations.
                    </p>

                    <h3 style="color: var(--cardinal-red);" class="mb-4 mt-5">What We Do</h3>
                    <p>
                        Our team delivers comprehensive services across nine key areas:
                    </p>
                    <ul class="list-unstyled">
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Customer Service:</strong> End-to-end customer
                            support and order management
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Human Resource:</strong> HR operations and
                            employee support services
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Clinical Services:</strong> Clinical support
                            and medical services coordination
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Employee Services:</strong> Comprehensive
                            employee support programs
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Supply Chain:</strong> Supply chain
                            optimization and logistics
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Information Technology:</strong> IT
                            infrastructure and application support
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Finance Services:</strong> Financial
                            operations, billing, and payment processing
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Enablement & Governance:</strong> Process
                            governance and quality assurance
                        </li>
                        <li class="mb-3">
                            <strong style="color: var(--cardinal-red);">Procurement Services:</strong> Strategic
                            procurement and vendor management
                        </li>
                    </ul>

                    <h3 style="color: var(--cardinal-red);" class="mb-4 mt-5">Global Presence</h3>
                    <p>
                        With operations spanning across the United States, Philippines, and India, our team of 5,200+
                        professionals
                        delivers 24/7 support to Cardinal Health's divisions including Medical, Pharma, AHS, and OEL.
                    </p>

                    <h3 style="color: var(--cardinal-red);" class="mb-4 mt-5">Our Commitment</h3>
                    <p>
                        We are committed to operational excellence, continuous improvement, and delivering exceptional
                        service quality that supports Cardinal Health's mission to improve the cost-effectiveness of
                        healthcare.
                    </p>
                </div>
            </div>

            <div class="text-center">
                <a href="@Url.Action("Index")" class="service-details-btn" style="display: inline-block; width:
                    auto;">
                    Explore Our Services &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
