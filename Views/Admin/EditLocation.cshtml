@model ServiceCatalog.Web.Models.Location

@{
    ViewData["Title"] = "Edit Location";
}

<section class="hero-section">
    <div class="container">
   <h1 class="hero-title">Edit Location</h1>
        <p class="hero-subtitle">Update location details</p>
</div>
</section>

<div class="container my-5 page-transition" style="padding-bottom: 120px;">
    <div class="row justify-content-center">
  <div class="col-md-8">
<div class="card border-0 shadow-sm admin-card">
    <div class="card-header admin-card-header" style="background: linear-gradient(135deg, var(--grasshopper) 0%, #5bbfa7 100%);">
       <h5 class="mb-0">?? Edit Location Details</h5>
 </div>
    <div class="card-body p-4">
        <form asp-action="EditLocation" method="post">
       @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
  <div class="col-md-6 mb-3">
  <label asp-for="Name" class="form-label">Location Name *</label>
        <input asp-for="Name" class="form-control" required />
      <span asp-validation-for="Name" class="text-danger"></span>
       </div>

 <div class="col-md-6 mb-3">
   <label asp-for="Country" class="form-label">Country *</label>
  <input asp-for="Country" class="form-control" required />
     <span asp-validation-for="Country" class="text-danger"></span>
    </div>
   </div>

 <div class="row">
     <div class="col-md-6 mb-3">
  <label asp-for="Region" class="form-label">Region *</label>
    <select asp-for="Region" class="form-select" required>
 <option value="EMEA">EMEA</option>
<option value="APAC">APAC</option>
      <option value="Americas">Americas</option>
  </select>
     <span asp-validation-for="Region" class="text-danger"></span>
   </div>

   <div class="col-md-6 mb-3">
     <label asp-for="EmployeeCount" class="form-label">Employee Count *</label>
     <input asp-for="EmployeeCount" type="number" class="form-control" required />
     <span asp-validation-for="EmployeeCount" class="text-danger"></span>
     </div>
    </div>

  <div class="mb-3">
  <label asp-for="FlagUrl" class="form-label">Flag URL</label>
<input asp-for="FlagUrl" class="form-control" />
    <span asp-validation-for="FlagUrl" class="text-danger"></span>
  </div>

<div class="row">
     <div class="col-md-6 mb-3">
   <label asp-for="Latitude" class="form-label">Latitude *</label>
  <input asp-for="Latitude" type="number" step="0.0001" class="form-control" required />
 <span asp-validation-for="Latitude" class="text-danger"></span>
      </div>

      <div class="col-md-6 mb-3">
    <label asp-for="Longitude" class="form-label">Longitude *</label>
  <input asp-for="Longitude" type="number" step="0.0001" class="form-control" required />
        <span asp-validation-for="Longitude" class="text-danger"></span>
      </div>
 </div>

     <div class="d-flex justify-content-between" style="margin-bottom: 40px;">
 <a href="@Url.Action("Locations", "Admin")" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--grasshopper) 0%, #5bbfa7 100%); border: none;">Update Location</button>
     </div>
 </form>
      </div>
   </div>
   </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
