@model ServiceCatalog.Web.Models.Capability

@{
    ViewData["Title"] = "Create Capability";
}

<section class="modern-hero-section hero-bg-capabilities" style="min-height: 35vh;">
    <!-- Wormhole Canvas -->
    <canvas id="wormhole-canvas"></canvas>
    
    <div class="container text-center" style="position: relative; z-index: 10;">
        <h1 class="hero-title" style="color: white; font-size: 2.5rem; font-weight: 800; margin-bottom: 0.8rem; text-shadow: 0 4px 20px rgba(0,0,0,0.3);">? Create Capability</h1>
  <p class="hero-subtitle" style="color: rgba(255,255,255,0.95); font-size: 1.2rem; font-weight: 300;">Add a new service capability category</p>
    </div>
</section>

<div class="container my-5 page-transition" style="padding-bottom: 120px;">
    <div class="row justify-content-center">
   <div class="col-lg-8">
 <div class="crud-form-container" style="animation: fadeInUp 0.6s ease-out;">
 <div class="crud-form-header" style="background: linear-gradient(135deg, var(--papillon), #9d7bc0);">
    <span style="font-size: 2rem;">??</span>
 <span>Capability Details</span>
  </div>

 <form asp-action="CreateCapability" method="post">
@Html.AntiForgeryToken()
     <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 15px; border: none; box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);"></div>

        <div class="form-group-modern">
            <label asp-for="Name" class="form-label-modern">
    Capability Name <span style="color: var(--cardinal-red);">*</span>
      </label>
     <input asp-for="Name" class="form-control-modern" placeholder="e.g., Customer Service" required />
   <span asp-validation-for="Name" class="text-danger" style="font-size: 0.875rem; margin-top: 5px; display: block;"></span>
  </div>

   <div class="form-group-modern">
     <label asp-for="Description" class="form-label-modern">
  Description <span style="color: var(--cardinal-red);">*</span>
    </label>
    <textarea asp-for="Description" class="form-control-modern" rows="4" placeholder="Describe this capability and its purpose..." required style="resize: vertical; min-height: 100px;"></textarea>
<span asp-validation-for="Description" class="text-danger" style="font-size: 0.875rem; margin-top: 5px; display: block;"></span>
  </div>

    <div class="row">
   <div class="col-md-6">
  <div class="form-group-modern">
 <label asp-for="Order" class="form-label-modern">
      Display Order <span style="color: var(--cardinal-red);">*</span>
  </label>
     <input asp-for="Order" type="number" class="form-control-modern" placeholder="e.g., 1" required min="1" />
 <span asp-validation-for="Order" class="text-danger" style="font-size: 0.875rem; margin-top: 5px; display: block;"></span>
      <small style="color: var(--warm-gray-7); font-size: 0.875rem; margin-top: 5px; display: block;">
  ?? Lower numbers appear first
     </small>
  </div>
    </div>

 <div class="col-md-6">
   <div class="form-group-modern">
     <label asp-for="ColorHex" class="form-label-modern">
      Color (Hex) <span style="color: var(--cardinal-red);">*</span>
 </label>
    <input asp-for="ColorHex" type="color" class="form-control-modern" value="#EC5A62" required style="height: 60px; cursor: pointer; padding: 8px;" />
    <span asp-validation-for="ColorHex" class="text-danger" style="font-size: 0.875rem; margin-top: 5px; display: block;"></span>
     <small style="color: var(--warm-gray-7); font-size: 0.875rem; margin-top: 5px; display: block;">
  ?? Choose a brand color
           </small>
   </div>
 </div>
     </div>

 <div style="background: linear-gradient(135deg, rgba(179, 144, 212, 0.1), rgba(157, 123, 192, 0.1)); padding: 20px; border-radius: 15px; margin: 30px 0; border-left: 4px solid var(--papillon);">
    <div style="display: flex; align-items: flex-start; gap: 15px;">
    <span style="font-size: 2rem;">??</span>
  <div>
       <strong style="color: var(--black); display: block; margin-bottom: 8px; font-size: 1.1rem;">Recommended Brand Colors</strong>
     <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 12px;">
 <div style="display: flex; align-items: center; gap: 6px;">
      <div style="width: 24px; height: 24px; border-radius: 6px; background: #EC5A62; box-shadow: 0 2px 6px rgba(0,0,0,0.2);"></div>
           <span style="color: var(--black-light); font-size: 0.9rem;">Cardinal Red</span>
   </div>
     <div style="display: flex; align-items: center; gap: 6px;">
      <div style="width: 24px; height: 24px; border-radius: 6px; background: #7BB1E8; box-shadow: 0 2px 6px rgba(0,0,0,0.2);"></div>
   <span style="color: var(--black-light); font-size: 0.9rem;">Blue Jay</span>
   </div>
   <div style="display: flex; align-items: center; gap: 6px;">
  <div style="width: 24px; height: 24px; border-radius: 6px; background: #69D2B7; box-shadow: 0 2px 6px rgba(0,0,0,0.2);"></div>
          <span style="color: var(--black-light); font-size: 0.9rem;">Grasshopper</span>
    </div>
   <div style="display: flex; align-items: center; gap: 6px;">
 <div style="width: 24px; height: 24px; border-radius: 6px; background: #B390D4; box-shadow: 0 2px 6px rgba(0,0,0,0.2);"></div>
     <span style="color: var(--black-light); font-size: 0.9rem;">Papillon</span>
    </div>
     <div style="display: flex; align-items: center; gap: 6px;">
        <div style="width: 24px; height: 24px; border-radius: 6px; background: #42B3D5; box-shadow: 0 2px 6px rgba(0,0,0,0.2);"></div>
      <span style="color: var(--black-light); font-size: 0.9rem;">Robin Egg Blue</span>
 </div>
       </div>
   </div>
      </div>
     </div>

 <div class="action-buttons-row">
         <a href="@Url.Action("Capabilities", "Admin")" class="btn-modern btn-modern-secondary" style="width: auto; padding: 14px 32px;">
       <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
         <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
   <span>Cancel</span>
       </a>
    <button type="submit" class="btn-modern btn-modern-primary" style="width: auto; padding: 14px 32px; background: linear-gradient(135deg, var(--papillon), #9d7bc0);">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
     <polyline points="17 21 17 13 7 13 7 21"/>
    <polyline points="7 3 7 8 15 8"/>
 </svg>
 <span>Create Capability</span>
     </button>
        </div>
    </form>
    </div>
    </div>
    </div>
</div>

@section Scripts {
<script src="~/js/wormhole.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
