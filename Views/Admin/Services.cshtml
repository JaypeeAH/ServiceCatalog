@model List<ServiceCatalog.Web.Models.Service>
@{
  ViewData["Title"] = "Manage Services";
}

<section class="modern-hero-section hero-bg-services" style="min-height: 35vh;">
    <!-- Wormhole Canvas -->
    <canvas id="wormhole-canvas"></canvas>
    
  <div class="container text-center" style="position: relative; z-index: 10;">
   <h1 class="hero-title" style="color: white; font-size: 2.5rem; font-weight: 800; margin-bottom: 0.8rem; text-shadow: 0 4px 20px rgba(0,0,0,0.3);">??? Manage Services</h1>
     <p class="hero-subtitle" style="color: rgba(255,255,255,0.95); font-size: 1.2rem; font-weight: 300;">Create, edit, and organize your service catalog</p>
    </div>
</section>

<div class="container my-5 page-transition" style="margin-bottom: 120px;">
    @if (TempData["Success"] != null)
  {
     <div class="alert alert-success alert-dismissible fade show" role="alert" style="animation: slideInRight 0.6s ease-out; border-radius: 15px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
      <strong>? Success!</strong> @TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  }

    <div class="d-flex justify-content-between align-items-center mb-5" style="animation: fadeInUp 0.6s ease-out;">
        <div>
      <h2 style="color: var(--black); font-weight: 700; font-size: 2rem; margin-bottom: 0.5rem;">All Services</h2>
            <p style="color: var(--black-light); margin: 0;">@Model.Count total services in the catalog</p>
   </div>
      <a asp-action="CreateService" class="btn-modern btn-modern-primary">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M5 12h14"/>
      </svg>
 <span>Add New Service</span>
      </a>
    </div>

    <div class="modern-table-container" style="animation: fadeInUp 0.6s ease-out 0.2s both;">
    <table class="modern-table">
            <thead>
     <tr>
           <th style="width: 80px;">Order</th>
    <th>Service Name</th>
  <th>Capability</th>
  <th>Description</th>
    <th style="text-align: center; width: 100px;">Processes</th>
       <th style="text-align: center; width: 200px;">Actions</th>
       </tr>
          </thead>
 <tbody>
       @foreach (var service in Model.OrderBy(s => s.Order))
            {
       <tr>
         <td style="font-weight: 700; font-size: 1.1rem; color: var(--cardinal-red);">@service.Order</td>
      <td>
     <strong style="color: var(--black); font-size: 1.1rem;">@service.Name</strong>
             </td>
        <td>
          <span class="badge-modern badge-modern-primary">@service.Capability.Name</span>
        </td>
     <td style="max-width: 350px; color: var(--black-light);">
     @(service.Description.Length > 120 ? service.Description.Substring(0, 120) + "..." : service.Description)
      </td>
         <td style="text-align: center;">
         <span class="badge-modern badge-modern-secondary" style="font-size: 1rem; padding: 10px 18px;">
       @service.Processes.Count
     </span>
            </td>
            <td style="text-align: center;">
     <div class="btn-group-modern" style="justify-content: center;">
 <a asp-action="EditService" asp-route-id="@service.Id" class="btn-icon btn-icon-edit" title="Edit Service">
     <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
     <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
  </svg>
 </a>
<form asp-action="DeleteService" asp-route-id="@service.Id" method="post" style="display: inline;" onsubmit="return confirm('?? Are you sure you want to delete this service?\n\nThis will also delete all associated processes and applicabilities.\n\nThis action cannot be undone.');">
  @Html.AntiForgeryToken()
   <button type="submit" class="btn-icon btn-icon-delete" title="Delete Service">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="3 6 5 6 21 6"></polyline>
               <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
  </svg>
       </button>
          </form>
       </div>
       </td>
  </tr>
      }
   </tbody>
        </table>
    </div>

    <div class="text-center mt-5" style="animation: fadeIn 0.8s ease-out 0.4s both;">
 <a asp-action="Index" class="btn-back-home">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
   <span>Back to Dashboard</span>
     </a>
  </div>
</div>

@section Scripts {
<script src="~/js/wormhole.js"></script>
}
