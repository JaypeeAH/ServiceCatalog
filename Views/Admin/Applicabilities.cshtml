@model IEnumerable<ServiceCatalog.Web.Models.ServiceApplicability>

@{
    ViewData["Title"] = "Manage Applicabilities";
}

<section class="modern-hero-section">
    <div class="container text-center" style="position: relative; z-index: 10;">
 <h1 class="hero-title" style="color: white; font-size: 3.5rem; font-weight: 800; margin-bottom: 1rem; text-shadow: 0 4px 20px rgba(0,0,0,0.3);">? Service Applicabilities</h1>
        <p class="hero-subtitle" style="color: rgba(255,255,255,0.95); font-size: 1.4rem; font-weight: 300;">Manage division applicability for all processes</p>
    </div>
</section>

<div class="container my-5 page-transition" style="padding-bottom: 120px;">
    @if (TempData["Success"] != null)
    {
 <div class="alert alert-success alert-dismissible fade show" role="alert" style="animation: slideInRight 0.6s ease-out; border-radius: 15px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
      <strong>? Success!</strong> @TempData["Success"]
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
   </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-5" style="animation: fadeInUp 0.6s ease-out;">
 <div>
     <h2 style="color: var(--black); font-weight: 700; font-size: 2rem; margin-bottom: 0.5rem;">All Applicabilities</h2>
    <p style="color: var(--black-light); margin: 0;">@Model.Count() division applicability configurations</p>
  </div>
 </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" style="border-radius: 20px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1); padding: 30px;">
  <h5 style="font-weight: 700; color: var(--black); margin-bottom: 10px;">No Applicabilities Found</h5>
       <p style="margin: 0; color: var(--black-light);">Applicabilities are automatically created when you add processes.</p>
        </div>
    }
  else
    {
        <div style="background: linear-gradient(135deg, rgba(66, 179, 213, 0.1), rgba(102, 126, 234, 0.1)); padding: 25px; border-radius: 20px; margin-bottom: 30px; border-left: 4px solid var(--robin-egg-blue); animation: fadeInUp 0.6s ease-out 0.2s both;">
<div style="display: flex; align-items: flex-start; gap: 15px;">
 <span style="font-size: 2rem;">??</span>
       <div>
         <strong style="color: var(--black); display: block; margin-bottom: 8px; font-size: 1.1rem;">About Applicabilities</strong>
           <p style="color: var(--black-light); margin: 0; line-height: 1.6;">
        Applicabilities define which divisions (Medical, Pharma, AHS, OFL) each process applies to. They are automatically created when you add a new process and can be edited individually.
    </p>
    </div>
     </div>
        </div>

     <div class="modern-table-container" style="animation: fadeInUp 0.6s ease-out 0.4s both;">
  <table class="modern-table">
    <thead>
           <tr>
          <th>Service</th>
         <th>Process</th>
 <th>Division</th>
       <th style="text-align: center; width: 150px;">Status</th>
     <th style="text-align: center; width: 150px;">Actions</th>
       </tr>
    </thead>
    <tbody>
         @{
   string currentService = "";
        string currentProcess = "";
       }
     @foreach (var app in Model.OrderBy(a => a.ServiceProcess.Service.Name).ThenBy(a => a.ServiceProcess.Name))
      {
var serviceChanged = app.ServiceProcess?.Service?.Name != currentService;
   var processChanged = app.ServiceProcess?.Name != currentProcess;
        
 if (serviceChanged)
      {
          currentService = app.ServiceProcess?.Service?.Name ?? "";
            currentProcess = app.ServiceProcess?.Name ?? "";
<tr style="background: linear-gradient(135deg, rgba(236, 90, 98, 0.1), rgba(222, 142, 192, 0.1));">
             <td colspan="5" style="padding: 15px 20px;">
        <strong style="color: var(--cardinal-red); font-size: 1.1rem; display: flex; align-items: center; gap: 10px;">
     <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
           Service: @currentService
         </strong>
        </td>
      </tr>
 }
        
       if (processChanged && !serviceChanged)
         {
     currentProcess = app.ServiceProcess?.Name ?? "";
         <tr style="background: linear-gradient(135deg, rgba(123, 177, 232, 0.05), rgba(106, 159, 212, 0.05));">
       <td></td>
 <td colspan="4" style="padding: 12px 20px;">
       <strong style="color: var(--blue-jay); display: flex; align-items: center; gap: 10px;">
       <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
   <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
   </svg>
     Process: @currentProcess
           </strong>
      </td>
 </tr>
   }

   <tr>
      <td></td>
       <td></td>
        <td>
  <span class="badge-modern badge-modern-primary" style="font-size: 0.95rem; padding: 8px 14px;">
       @app.Division
     </span>
 </td>
    <td style="text-align: center;">
  @if (app.IsApplicable)
     {
    <span class="badge-modern badge-modern-success" style="font-size: 0.9rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
        <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
      Applicable
    </span>
     }
        else
    {
       <span class="badge-modern" style="background: linear-gradient(135deg, var(--warm-gray-7), var(--warm-gray-7-dark)); font-size: 0.9rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
     <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        Not Applicable
 </span>
     }
      </td>
      <td style="text-align: center;">
   <a href="@Url.Action("EditApplicability", "Admin", new { id = app.Id })" class="btn-icon btn-icon-edit" title="Edit Applicability">
     <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
        </a>
        </td>
       </tr>
      }
  </tbody>
</table>
      </div>
    }

    <div class="text-center mt-5" style="animation: fadeIn 0.8s ease-out 0.6s both;">
  <a href="@Url.Action("Index", "Admin")" class="btn-back-home">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
   <span>Back to Dashboard</span>
      </a>
  </div>
</div>
