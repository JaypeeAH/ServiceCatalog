  "components": {
    "schemas": {
      "Capability": {
        "required": [
          "colorHex",
          "description",
          "name",
          "order"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "order": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "colorHex": {
            "minLength": 1,
            "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Location": {
        "required": [
          "country",
          "employeeCount",
          "latitude",
          "longitude",
          "name",
          "region"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "country": {
            "minLength": 1,
            "type": "string"
          },
          "region": {
            "minLength": 1,
            "type": "string"
          },
          "flagUrl": {
            "type": "string",
            "nullable": true
          },
          "employeeCount": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "Service": {
        "required": [
          "capabilityId",
          "description",
          "name",
          "order"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "capabilityId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "order": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "capability": {
            "$ref": "#/components/schemas/Capability"
          },
          "processes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceProcess"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ServiceApplicability": {
        "required": [
          "division",
          "serviceProcessId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "serviceProcessId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "division": {
            "minLength": 1,
            "type": "string"
          },
          "isApplicable": {
            "type": "boolean"
          },
          "serviceProcess": {
            "$ref": "#/components/schemas/ServiceProcess"
          }
        },
        "additionalProperties": false
      },
      "ServiceProcess": {
        "required": [
          "description",
          "name",
          "order",
          "serviceId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "serviceId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "order": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          },
          "applicabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceApplicability"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}